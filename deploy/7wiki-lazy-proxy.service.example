[Unit]
Description=Seven Degrees Wikipedia lazy-loading proxy
After=network.target

[Service]
Type=simple
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=7878
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=7879
Environment=BACKEND_UNIT=7wiki-backend.service
Environment=IDLE_TIMEOUT_MS=90000
Environment=START_TIMEOUT_MS=120000
ExecStart=/usr/bin/node %h/Documents/GitHub/7degreesofwikipedia/deploy/lazy-proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
