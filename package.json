{
  "name": "six-degrees-of-wikipedia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/server/index.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "prestart": "npm run build",
    "start": "node --max-old-space-size=65536 dist/server/index.js",
    "prebuild:graph": "npm run build",
    "build:graph": "node --max-old-space-size=65536 dist/build/cli.js",
    "precli": "npm run build",
    "cli": "node --max-old-space-size=65536 dist/cli/index.js",
    "preinspect:artifact": "npm run build",
    "inspect:artifact": "node --max-old-space-size=65536 dist/runtime/inspectArtifact.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
